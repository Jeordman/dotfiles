#!/bin/bash
set -euo pipefail

# dev-init - Initialize a workflow with Claude and Neovim
# Auto-detects CMUX vs herdr and dispatches accordingly.
# Usage: dev-init [-d DIRECTORY] [-s] [-t TICKET] [-f]
#   -d DIRECTORY     Working directory (default: current directory)
#   -s               Add a third plain shell window/tab (used by dev-cloud)
#   -t TICKET        Ticket ID to fetch from ClickUp and start Claude in auto-accept mode
#   -f               Foreground the new workspace. Default is background — build it
#                    without stealing focus.
#
# Session name is automatically derived from the directory name.
#
# No dev server is ever started. Run `npm i` / `npm run dev` yourself in whatever
# window you want it in — auto-starting it caused more problems than it solved.
#
# This used to carry a third implementation for tmux. tmux is gone from these
# dotfiles, so dev-init is now purely a dispatcher: all the layout logic lives in
# dev-init-cmux and dev-init-herdr.

# Auto-detect the active multiplexer and delegate. CMUX first, then herdr.
if [ -n "${CMUX_WORKSPACE_ID:-}" ]; then
  # Forward all flags to dev-init-cmux (-d, -s, -t, -f)
  exec dev-init-cmux "$@"
fi
if [ "${HERDR_ENV:-}" = "1" ] && [ -n "${HERDR_PANE_ID:-}" ]; then
  # Forward all flags to dev-init-herdr (-d, -s, -t, -f)
  exec dev-init-herdr "$@"
fi

echo "Error: dev-init needs a CMUX workspace or a herdr pane." >&2
echo "Neither CMUX_WORKSPACE_ID nor HERDR_ENV/HERDR_PANE_ID is set." >&2
echo "Start cmux or herdr first, then run dev-init from inside it." >&2
exit 1
