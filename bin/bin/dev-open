#!/bin/bash
set -euo pipefail

# dev-open - Open the current directory in a CMUX workspace
# Usage: dev-open
#
# Creates a workspace named after the current directory with 2 tabs:
#   Tab 1: Claude Code
#   Tab 2: Neovim
#
# No dev server is ever started. Run `npm i` / `npm run dev` yourself in whatever
# pane you want it in — auto-starting it caused more problems than it solved.

WORK_DIR="$(pwd)"
# Label = the branch's descriptive slug. Drop the "new-shop-" worktree prefix and
# any leading "<type>-<TICKET>-" (e.g. feat-ECOM-6482-) so the workspace reads
# "buy-now-..." instead of "feat-ECOM-6482-buy-now-...". This is purely cosmetic:
# `git gtr rm` cleanup (gtr-preremove) matches workspaces by pane cwd, not by label.
SESSION_NAME="$(basename "$WORK_DIR" | sed -E 's/^new-shop-//; s/^([a-z]+-)?[A-Z]+-[0-9]+-//')"

if ! command -v cmux &>/dev/null; then
  echo "Error: cmux not found. Install from https://www.cmux.dev"
  exit 1
fi

send_cmd() {
  local surface="$1"
  local cmd="$2"
  cmux send --workspace "$WS_ID" --surface "$surface" "$cmd"
  cmux send-key --workspace "$WS_ID" --surface "$surface" enter
}

echo "Creating CMUX workspace: $SESSION_NAME"
WS_ID=$(cmux new-workspace | grep -oE 'workspace:[0-9]+')

cmux rename-workspace --workspace "$WS_ID" "$SESSION_NAME"
cmux reorder-workspace --workspace "$WS_ID" --index 999

TAB1=$(cmux list-pane-surfaces --workspace "$WS_ID" | grep -oE 'surface:[0-9]+' | head -1)
TAB2=$(cmux new-surface --workspace "$WS_ID" | grep -oE 'surface:[0-9]+')

# NOTE: TAB1 (the claude tab) is intentionally left unnamed. cmux's
# workspaceAutoNaming auto-titles agent tabs from the conversation at each
# turn-end, but a manual rename pins the tab and permanently blocks auto-naming.
# neovim is a non-agent tab, so auto-naming never touches it.
cmux rename-tab --workspace "$WS_ID" --surface "$TAB2" "neovim"

echo "Starting Claude in tab 1..."
send_cmd "$TAB1" "cd $WORK_DIR"
send_cmd "$TAB1" "claude"

echo "Starting Neovim in tab 2..."
send_cmd "$TAB2" "cd $WORK_DIR"
send_cmd "$TAB2" "nvim ."

CALLER_SURFACE="${CMUX_SURFACE_ID:-}"
cmux select-workspace --workspace "$WS_ID"

echo "Workspace ready!"

if [ -n "$CALLER_SURFACE" ]; then
  cmux close-surface --surface "$CALLER_SURFACE"
fi
