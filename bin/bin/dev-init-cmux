#!/bin/bash
set -euo pipefail

# dev-init-cmux - Initialize a CMUX workflow with Claude and Neovim
# Usage: dev-init-cmux [-d DIRECTORY] [-s] [-t TICKET] [-f]
#   -d DIRECTORY     Working directory (default: current directory)
#   -s               Add a third plain shell tab (used by dev-cloud for the branch watcher)
#   -t TICKET        Ticket ID to fetch from ClickUp and start Claude in auto-accept mode
#   -f               Foreground: switch to the new workspace and close the launcher
#                    terminal. Default is background — the workspace is built without
#                    stealing focus, so you stay where you are (it appears in the sidebar).
#
# Creates a workspace with 2 tabs:
#   Tab 1: Claude Code
#   Tab 2: Neovim
#
# No dev server is ever started. Run `npm i` / `npm run dev` yourself in whatever
# pane you want it in — auto-starting it caused more problems than it solved.

WORK_DIR="$(pwd)"
SHELL_TAB=false
TICKET=""
FOREGROUND=false

# Parse arguments
while getopts "d:st:f" opt; do
  case $opt in
    d) WORK_DIR="$OPTARG" ;;
    s) SHELL_TAB=true ;;
    t) TICKET="$OPTARG" ;;
    f) FOREGROUND=true ;;
    *) echo "Usage: $0 [-d DIRECTORY] [-s] [-t TICKET] [-f]"; exit 1 ;;
  esac
done

# Try to find the directory
if [ ! -d "$WORK_DIR" ]; then
  FALLBACK_DIR="$HOME/unicity/$WORK_DIR"
  if [ -d "$FALLBACK_DIR" ]; then
    WORK_DIR="$FALLBACK_DIR"
  else
    echo "Error: Directory not found in current directory or ~/unicity/"
    echo "Looked in: $WORK_DIR and $FALLBACK_DIR"
    exit 1
  fi
fi

# Convert to absolute path
WORK_DIR="$(cd "$WORK_DIR" && pwd)"
# Label = the branch's descriptive slug. Drop the "new-shop-" worktree prefix and
# any leading "<type>-<TICKET>-" (e.g. feat-ECOM-6482-) so the workspace reads
# "buy-now-..." instead of "feat-ECOM-6482-buy-now-...". This is purely cosmetic:
# `git gtr rm` cleanup (gtr-preremove) matches workspaces by pane cwd, not by label.
SESSION_NAME="$(basename "$WORK_DIR" | sed -E 's/^new-shop-//; s/^([a-z]+-)?[A-Z]+-[0-9]+-//')"

# Check cmux is available
if ! command -v cmux &>/dev/null; then
  echo "Error: cmux not found. Install from https://www.cmux.dev"
  exit 1
fi

# Helper: send a command to a surface in the new workspace
send_cmd() {
  local surface="$1"
  local cmd="$2"
  cmux send --workspace "$WS_ID" --surface "$surface" "$cmd"
  cmux send-key --workspace "$WS_ID" --surface "$surface" enter
}

# Create a new workspace. Build it in the background (--focus false) unless
# the caller asked to jump straight to it with -f.
NEW_FOCUS_FLAG="--focus false"
[ "$FOREGROUND" = true ] && NEW_FOCUS_FLAG="--focus true"

echo "Creating CMUX workspace: $SESSION_NAME"
WS_ID=$(cmux new-workspace $NEW_FOCUS_FLAG | grep -oE 'workspace:[0-9]+')

# Rename the workspace in the sidebar
cmux rename-workspace --workspace "$WS_ID" "$SESSION_NAME"

# Move workspace to the bottom of the sidebar
cmux reorder-workspace --workspace "$WS_ID" --index 999

# Get the first surface (created with the workspace)
# Output format: "* surface:14  Terminal 3  [selected]"
TAB1=$(cmux list-pane-surfaces --workspace "$WS_ID" | grep -oE 'surface:[0-9]+' | head -1)

# Create the remaining tabs (order matters: new surfaces insert after the selected
# tab, so we create them in reverse order to get: claude | neovim [| shell])
# Output format: "OK surface:15 pane:9 workspace:6"
# --focus false so building the tabs doesn't yank the screen to this workspace.
TAB3=""
if [ "$SHELL_TAB" = true ]; then
  TAB3=$(cmux new-surface --workspace "$WS_ID" $NEW_FOCUS_FLAG | grep -oE 'surface:[0-9]+')
fi
TAB2=$(cmux new-surface --workspace "$WS_ID" $NEW_FOCUS_FLAG | grep -oE 'surface:[0-9]+')

# Rename tabs
# NOTE: TAB1 (the claude tab) is intentionally left unnamed. cmux's
# workspaceAutoNaming (automation.workspaceAutoNaming in cmux.json) auto-titles
# agent tabs from the conversation at each turn-end, but a manual rename pins the
# tab and permanently blocks auto-naming. neovim/shell are non-agent tabs, so
# auto-naming never touches them — keep their labels.
cmux rename-tab --workspace "$WS_ID" --surface "$TAB2" "neovim"
if [ -n "$TAB3" ]; then
  cmux rename-tab --workspace "$WS_ID" --surface "$TAB3" "shell"
fi

# Build Claude command
claude_cmd="claude"
if [ -n "$TICKET" ]; then
  prompt="Use the ClickUp MCP to search for task $TICKET. Read the task description and create an implementation plan."
  if [ -f "$WORK_DIR/.claude/skills/planning/SKILL.md" ]; then
    prompt="/planning $prompt"
  fi
  claude_cmd="claude --permission-mode acceptEdits \"$prompt\""
fi

# Send commands to each tab
echo "Starting Claude in tab 1..."
send_cmd "$TAB1" "cd $WORK_DIR"
send_cmd "$TAB1" "$claude_cmd"

echo "Starting Neovim in tab 2..."
send_cmd "$TAB2" "cd $WORK_DIR"
send_cmd "$TAB2" "nvim ."

if [ -n "$TAB3" ]; then
  echo "Shell ready in tab 3."
  send_cmd "$TAB3" "cd $WORK_DIR"
fi

CALLER_SURFACE="${CMUX_SURFACE_ID:-}"

if [ "$FOREGROUND" = true ]; then
  # Switch to the new workspace and close the launcher terminal.
  cmux select-workspace --workspace "$WS_ID"
  echo "Workspace ready!"
  if [ -n "$CALLER_SURFACE" ]; then
    cmux close-surface --surface "$CALLER_SURFACE"
  fi
else
  # Background: leave focus where it is. The workspace sits in the sidebar,
  # ready to click into whenever you want it. Don't close the launcher terminal.
  echo "Workspace '$SESSION_NAME' ready in the background (see the sidebar)."
fi
