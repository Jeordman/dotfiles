#!/bin/bash
set -euo pipefail

# dev-init-herdr - Initialize a herdr workflow with Claude and Neovim
# Usage: dev-init-herdr [-d DIRECTORY] [-s] [-t TICKET] [-f]
#   -d DIRECTORY     Working directory (default: current directory)
#   -s               Add a third plain shell tab (used by dev-cloud for the branch watcher)
#   -t TICKET        Ticket ID to fetch from ClickUp and start Claude in auto-accept mode
#   -f               Foreground: focus the new workspace and close the launcher pane.
#                    Default is background — the workspace is built without stealing
#                    focus, so you stay where you are (it shows up in the picker).
#
# Creates a workspace with 2 tabs:
#   Tab 1: Claude Code
#   Tab 2: Neovim
#
# No dev server is ever started. Run `npm i` / `npm run dev` yourself in whatever
# pane you want it in — auto-starting it caused more problems than it solved.
#
# This is the herdr sibling of dev-init-cmux. dev-init auto-dispatches here when
# it detects a herdr session (HERDR_ENV=1). herdr's CLI mirrors cmux's primitives:
#   cmux new-workspace      -> herdr workspace create
#   cmux new-surface        -> herdr tab create
#   cmux send + send-key    -> herdr pane run (send text + Enter in one call)
#   cmux rename-tab         -> herdr tab rename
#   cmux select-workspace   -> herdr workspace focus
#   cmux close-surface      -> herdr pane close
# herdr returns JSON-RPC (parse IDs with jq) instead of "workspace:N" strings.

WORK_DIR="$(pwd)"
SHELL_TAB=false
TICKET=""
FOREGROUND=false

# Parse arguments
while getopts "d:st:f" opt; do
  case $opt in
    d) WORK_DIR="$OPTARG" ;;
    s) SHELL_TAB=true ;;
    t) TICKET="$OPTARG" ;;
    f) FOREGROUND=true ;;
    *) echo "Usage: $0 [-d DIRECTORY] [-s] [-t TICKET] [-f]"; exit 1 ;;
  esac
done

# Try to find the directory
if [ ! -d "$WORK_DIR" ]; then
  FALLBACK_DIR="$HOME/unicity/$WORK_DIR"
  if [ -d "$FALLBACK_DIR" ]; then
    WORK_DIR="$FALLBACK_DIR"
  else
    echo "Error: Directory not found in current directory or ~/unicity/"
    echo "Looked in: $WORK_DIR and $FALLBACK_DIR"
    exit 1
  fi
fi

# Convert to absolute path
WORK_DIR="$(cd "$WORK_DIR" && pwd)"
# Label = the branch's descriptive slug. Drop the "new-shop-" worktree prefix and
# any leading "<type>-<TICKET>-" (e.g. feat-ECOM-6482-) so the workspace reads
# "buy-now-..." instead of "feat-ECOM-6482-buy-now-...". Purely cosmetic:
# `git gtr rm` cleanup (gtr-preremove) never matches on the label — it uses the
# workspace id recorded below, falling back to pane cwd.
SESSION_NAME="$(basename "$WORK_DIR" | sed -E 's/^new-shop-//; s/^([a-z]+-)?[A-Z]+-[0-9]+-//')"

# Where we record "this worktree -> this workspace id" for gtr-preremove.
# Keep this path + filename encoding in sync with gtr-preremove.
WS_MAP_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dev-init/herdr-workspaces"
WS_MAP_FILE="$WS_MAP_DIR/$(printf '%s' "$WORK_DIR" | tr '/' '%')"

# Check herdr is available
if ! command -v herdr &>/dev/null; then
  echo "Error: herdr not found."
  exit 1
fi
if ! command -v jq &>/dev/null; then
  echo "Error: jq not found (needed to parse herdr output)."
  exit 1
fi

# Build it in the background (--no-focus) unless the caller asked for -f.
FOCUS_FLAG="--no-focus"
[ "$FOREGROUND" = true ] && FOCUS_FLAG="--focus"

echo "Creating herdr workspace: $SESSION_NAME"

# Create the workspace rooted in WORK_DIR. --cwd makes every pane start there,
# so we never have to `cd` before running commands. The workspace ships with one
# tab + pane (the "root pane") — that's our Claude tab.
ws_json=$(herdr workspace create --cwd "$WORK_DIR" --label "$SESSION_NAME" $FOCUS_FLAG)
WS_ID=$(printf '%s' "$ws_json"   | jq -r '.result.workspace.workspace_id')
TAB1_PANE=$(printf '%s' "$ws_json" | jq -r '.result.root_pane.pane_id')

if [ -z "$WS_ID" ] || [ "$WS_ID" = "null" ]; then
  echo "Error: failed to create herdr workspace. Output was:"
  printf '%s\n' "$ws_json"
  exit 1
fi

# Record the mapping so `git gtr rm <branch>` can close this workspace even after
# every pane has cd'd out of the worktree (e.g. into the main repo to fix a
# conflict) — pane-cwd matching alone misses that case. Best-effort.
mkdir -p "$WS_MAP_DIR" 2>/dev/null && printf '%s\n' "$WS_ID" > "$WS_MAP_FILE" 2>/dev/null || true

# Create the neovim tab (and the optional shell tab) — herdr appends, so this
# gives claude | neovim [| shell]. Always --no-focus so building tabs doesn't
# yank focus.
tab2_json=$(herdr tab create --workspace "$WS_ID" --cwd "$WORK_DIR" --label "neovim" --no-focus)
TAB2_PANE=$(printf '%s' "$tab2_json" | jq -r '.result.root_pane.pane_id')

TAB3_PANE=""
if [ "$SHELL_TAB" = true ]; then
  tab3_json=$(herdr tab create --workspace "$WS_ID" --cwd "$WORK_DIR" --label "shell" --no-focus)
  TAB3_PANE=$(printf '%s' "$tab3_json" | jq -r '.result.root_pane.pane_id')
fi

# Deliberately DON'T name the Claude tab. herdr surfaces the live agent identity
# itself — it renders terminal_title_stripped (the title Claude updates as it
# works) in the agent panel, the `prefix a` picker, and (with
# show_agent_labels_on_pane_borders) on pane borders. Pinning a manual label here
# would just impose a static name over that. Only the non-agent tabs
# (neovim/shell) get fixed labels, since herdr has nothing dynamic to show.

# Build Claude command
# Name the Remote Control session after the worktree directory, so the
# claude.ai/code and phone session lists say which worktree a session belongs to
# instead of titling the row from the conversation. The zsh claude() wrapper does
# the same for hand-typed launches; passing it here keeps it right even when the
# pane shell isn't zsh.
RC_NAME="$(basename "$WORK_DIR")"
claude_cmd="claude --remote-control \"$RC_NAME\" --effort xhigh"
if [ -n "$TICKET" ]; then
  prompt="Use the ClickUp MCP to search for task $TICKET. Read the task description and create an implementation plan."
  if [ -f "$WORK_DIR/.claude/skills/planning/SKILL.md" ]; then
    prompt="/planning $prompt"
  fi
  claude_cmd="claude --remote-control \"$RC_NAME\" --effort xhigh --permission-mode acceptEdits \"$prompt\""
fi

# Run the commands. `herdr pane run` writes the command + Enter in one call, and
# the pane already lives in WORK_DIR thanks to --cwd above.
echo "Starting Claude in tab 1..."
herdr pane run "$TAB1_PANE" "$claude_cmd" >/dev/null

echo "Starting Neovim in tab 2..."
herdr pane run "$TAB2_PANE" "nvim ." >/dev/null

if [ -n "$TAB3_PANE" ]; then
  echo "Shell ready in tab 3."
fi

CALLER_PANE="${HERDR_PANE_ID:-}"

if [ "$FOREGROUND" = true ]; then
  herdr workspace focus "$WS_ID" >/dev/null
  echo "Workspace ready!"
  # Close the launcher pane last (this may terminate the current shell).
  if [ -n "$CALLER_PANE" ]; then
    herdr pane close "$CALLER_PANE" >/dev/null 2>&1 || true
  fi
else
  echo "Workspace '$SESSION_NAME' ready in the background (see the herdr picker)."
fi
