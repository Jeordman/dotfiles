# Match cmux's palette exactly (fixes muted lazygit/TUI colors).
# cmux uses libghostty + this bundled theme; its bg is already #1e1e1e.
theme = "Apple System Colors"

# Neutral near-black to match Conductor. The old 141110 was warm/brown,
# which fought the cool grays in herdr and nvim.
# This is the innermost surface and the darkest of the three:
# herdr sidebar #161616 -> herdr panel #101010 -> this.
background = 0c0c0c

# Neutral selection and cursor instead of the theme's blue.
selection-background = 2a2a2a
selection-foreground = ededed
cursor-color = d0d0d0

# Set background transparency (0.0 = fully transparent, 1.0 = opaque)
background-opacity = 1

# Enable blur behind the terminal
background-blur = true

# Optional: adjust the amount of blur if Ghostty supports it
background-blur-radius = 10

font-size = 16
font-family = "Hack Nerd Font"

# Conductor breathes; a terminal grid does not unless you tell it to.
window-padding-x = 12
window-padding-y = 8

# Loosens every row ~10%. herdr's row_gap is integer-only (0 or a full blank
# line, which was too much), so line height is the fine-grained lever.
adjust-cell-height = 10%

title = " "

# Tabs live in the titlebar instead of their own row below it.
# Swap to `hidden` to drop the titlebar (and traffic lights) entirely.
macos-titlebar-style = tabs

