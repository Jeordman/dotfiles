# Python bytecode (regenerated automatically)
__pycache__/
*.pyc

# Superset-managed Claude plugin. The desktop app provisions and overwrites this
# on every launch/update (each skill carries a .superset-managed sentinel), so
# tracking it only produces conflicts. Disable individual skills through the
# desktop's skill toggles or ~/.superset/disabled-skills.json, never by editing
# files here.
claude/.claude/skills/superset/

# Claude Code's synced skills cache (pulled from the claude.ai account, keyed by
# account+org UUID). Claude Code rewrites it on sync, and ~/.claude/skills is a
# symlink into this repo, so it lands here uninvited. Nothing here is authored.
claude/.claude/skills/synced/

# Employer-internal notes (ClickUp ids, board layout). Kept local; this repo is public.
docs/private/

# Skills deleted through the desktop app land here; some carry third-party licenses.
claude/.claude/skills/.trash/
