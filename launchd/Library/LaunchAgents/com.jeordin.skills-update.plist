<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily update of CLI-managed agent skills. See bin/bin/skills-update.
  Stowed from ~/dotfiles/launchd; loaded by install/modules/05-dotfiles.sh.
  launchd can't expand ~ or $HOME, so zsh resolves the script path.
  If the Mac is asleep at the scheduled time, launchd runs it on wake.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jeordin.skills-update</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>exec "$HOME/bin/skills-update"</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <!-- Only catches failures before the script starts logging (e.g. zsh can't find it). -->
    <key>StandardErrorPath</key>
    <string>/tmp/com.jeordin.skills-update.err</string>
</dict>
</plist>
